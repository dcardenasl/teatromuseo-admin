#--------------------------------------------------------------------
# REQUIRED CONFIGURATION
# Must be configured before the application can run
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# Environment & Base URL (REQUIRED)
#--------------------------------------------------------------------

CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8182/'
# Enable these in production behind HTTPS.
# app.forceGlobalSecureRequests = true
# app.CSPEnabled = true

#--------------------------------------------------------------------
# Session / Cookies
#--------------------------------------------------------------------

# SESSION_DRIVER is the short form read directly by Config\Session (audit B10.3):
# one of file|redis|database|memcached. Default: file (single-server only).
# SESSION_DRIVER = file
# session.savePath = '/absolute/path/to/writable/session'

# Shared dashboard cache. File is safe for one shared filesystem; use Redis or
# Memcached when workers run on separate hosts.
# ADMIN_CACHE_HANDLER = file

# For horizontal scaling (load-balanced clusters):
# Use Redis: requires predis/predis in composer.json
# SESSION_DRIVER = redis
# session.savePath = 'tcp://redis:6379'

# Or use database:
# SESSION_DRIVER = database
# session.savePath = 'sessions'

# Security
# cookie.secure = true
# WEBAPP_BASE_URL = 'https://yourdomain.com'

#--------------------------------------------------------------------
# API Client (REQUIRED)
# Backend API configuration - application will not work without these
#--------------------------------------------------------------------

apiClient.baseUrl = 'http://localhost:8180'
apiClient.apiPrefix = '/api/v1'

# OPTIONAL: App identification for higher rate limits (60 → 600 req/min)
# Generate a key via admin panel at /admin/api-keys
# apiClient.appKey = 'apk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'

# OPTIONAL: Custom app name and request logging
# apiClient.appName = 'Teatromuseo Admin'
# apiClient.logRequests = false

#--------------------------------------------------------------------
# Domain API Clients
# Specific backend endpoints for CMS, Catalog, and Event domain apps
#--------------------------------------------------------------------

# CMS Domain App (puerto 8190) — Config\DomainApiClient reads DOMAIN_API_* (not CMS_DOMAIN_API_*)
DOMAIN_API_BASE_URL = http://localhost:8190
# DOMAIN_API_APP_KEY = apk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Catalog Domain App (puerto 8191)
CATALOG_DOMAIN_API_BASE_URL = http://localhost:8191
# CATALOG_DOMAIN_API_KEY = apk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Event Domain App (puerto 8193)
EVENT_DOMAIN_API_BASE_URL = http://localhost:8193
# EVENT_DOMAIN_API_KEY = apk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# BFF (Backend-for-Frontend) — used by decoupled clients (port 8188)
BFF_API_BASE_URL = http://localhost:8188
# BFF_API_APP_KEY = apk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public Web Site & Cache Invalidation
PUBLIC_SITE_URL = http://localhost:8184
# CACHE_INVALIDATE_KEY = secret_key_for_stale_cache_invalidation
# Sent as X-Block-Preview-Key when proxying to the public site's
# /blocks/preview (see BlockPreviewController). Must match the public site's
# BLOCK_PREVIEW_KEY exactly, or that endpoint's key check will reject it.
# BLOCK_PREVIEW_KEY = secret_key_for_block_preview

#--------------------------------------------------------------------
# ENCRYPTION (REQUIRED)
# Generate a key using: php spark key:generate
#--------------------------------------------------------------------

encryption.key = ''

#--------------------------------------------------------------------
# OPTIONAL CONFIGURATION
# These can be left as defaults for development
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# Auth / Files
#--------------------------------------------------------------------

# Optional: Google OAuth configuration
# GOOGLE_CLIENT_ID = ''

# File upload limit: 10MB default (in bytes)
FILE_MAX_SIZE = 10485760

#--------------------------------------------------------------------
# PUBLIC WEBSITE URL (used to generate "View Page" preview links in the admin)
#--------------------------------------------------------------------
# URL of the ci4-website-builder-web frontend. No trailing slash.
# PUBLIC_SITE_URL = http://localhost:8184

# Shared secret with the public website's cache invalidation webhook.
# CACHE_INVALIDATE_KEY = 'CHANGE_ME'

#--------------------------------------------------------------------
# PUBLIC WEBSITE HEALTH MONITORING
#--------------------------------------------------------------------
# Base URL of ci4-website-builder-web used by the dashboard health card.
# Leave empty (default) to hide the web health card entirely.
# webApiClient.baseUrl = http://localhost:8184
# webApiClient.logRequests = false

#--------------------------------------------------------------------
# CMS PREVIEW LINKS
#--------------------------------------------------------------------
# Shared with ci4-website-builder-domain's CMS_PREVIEW_SECRET — must match.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
# CMS_PREVIEW_SECRET =

#--------------------------------------------------------------------
# Email / Notifications (OPTIONAL)
# Configure if you need to send emails
#--------------------------------------------------------------------

# SMTP_HOST = 'localhost'
# SMTP_USER = ''
# SMTP_PASS = ''
# SMTP_CRYPTO = 'tls'
# SMTP_PORT = 587
# EMAIL_FROM = ''
# EMAIL_FROM_NAME = 'CI4 Admin'
# Admin write rate limit (GET/HEAD navigation is not throttled)
ADMIN_RATE_LIMIT_REQUESTS = 200
ADMIN_RATE_LIMIT_WINDOW = 60

# Dashboard delivery budgets
ADMIN_DASHBOARD_FRESH_TTL = 300
ADMIN_DASHBOARD_STALE_TTL = 3600
ADMIN_DASHBOARD_FAILURE_COOLDOWN = 15
ADMIN_DASHBOARD_LOCK_MAX_AGE = 120
ADMIN_DASHBOARD_LOCK_WAIT_MS = 250
ADMIN_DASHBOARD_MAX_RETRIES = 0

#--------------------------------------------------------------------
# Maintenance Mode
#--------------------------------------------------------------------

# Set to 'true' to return 503 for all non-health requests.
# MAINTENANCE_MODE = false
# MAINTENANCE_MESSAGE = 'Service is temporarily unavailable for maintenance.'
# MAINTENANCE_RETRY_AFTER = 60

#--------------------------------------------------------------------
# Asset Cache Busting
#--------------------------------------------------------------------

# Busts CSS/JS caches on every deploy. Usually set by CI to the git commit hash.
# ASSET_VERSION = '1.0.0'
