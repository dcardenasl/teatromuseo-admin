# Teatro Museo Admin — environment template
# Copy to .env and replace every placeholder secret before deploying.
# Dotted keys are the preferred CodeIgniter configuration form. The uppercase
# names documented at the end are compatibility fallbacks for older installs.

# -----------------------------------------------------------------------------
# Runtime and application
# -----------------------------------------------------------------------------

CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8182/'
app.appTimezone = 'America/Santiago'
APP_NAME = 'Teatromuseo Admin'
APP_DATE_FORMAT = 'd/m/Y H:i'
ASSET_VERSION = 'local'
LOG_FORMAT = 'text'

# Enable only when the Admin is served behind HTTPS in production.
# app.forceGlobalSecureRequests = true
# app.CSPEnabled = true
# app.cspReportURI = ''

# -----------------------------------------------------------------------------
# Session and cache
# -----------------------------------------------------------------------------

# file|redis|database|memcached. File is appropriate for one host.
SESSION_DRIVER = file
# SESSION_SAVE_PATH = '/absolute/path/to/writable/session'

# file|redis|memcached, depending on the installed PHP extension/driver.
cache.handler = file

# Optional explicit permission scope for local/service accounts.
# ADMIN_PERMISSIONS = 'cms.pages.read,cms.entries.read'

# -----------------------------------------------------------------------------
# Hub API client (required)
# -----------------------------------------------------------------------------

apiClient.baseUrl = 'http://localhost:8180'
apiClient.apiPrefix = '/api/v1'
apiClient.timeout = 15
apiClient.connectTimeout = 5
apiClient.maxRetries = 0
apiClient.appName = 'Teatromuseo Admin'
# apiClient.appKey = 'apk_replace_me'
apiClient.logRequests = false

# -----------------------------------------------------------------------------
# CMS/domain API clients
# -----------------------------------------------------------------------------

domainApiClient.baseUrl = 'http://localhost:8190'
domainApiClient.apiPrefix = '/api/v1'
domainApiClient.timeout = 15
domainApiClient.connectTimeout = 5
domainApiClient.appName = 'Teatromuseo Admin CMS'
# domainApiClient.appKey = 'apk_replace_me'
domainApiClient.logRequests = false

catalogDomainApiClient.baseUrl = 'http://localhost:8191'
catalogDomainApiClient.appName = 'Teatromuseo Admin Catalog'
# catalogDomainApiClient.appKey = 'apk_replace_me'

eventDomainApiClient.baseUrl = 'http://localhost:8193'
eventDomainApiClient.appName = 'Teatromuseo Admin Event'
# eventDomainApiClient.appKey = 'apk_replace_me'

# -----------------------------------------------------------------------------
# Authenticated BFF client (required for composite Admin reads)
# -----------------------------------------------------------------------------

bffApiClient.baseUrl = 'http://localhost:8188'
bffApiClient.apiPrefix = '/api/v1'
bffApiClient.timeout = 15
bffApiClient.connectTimeout = 5
bffApiClient.appName = 'Teatromuseo Admin BFF'
# bffApiClient.appKey = 'apk_replace_me'
bffApiClient.logRequests = false

# -----------------------------------------------------------------------------
# Public Web integration and preview/cache invalidation
# -----------------------------------------------------------------------------

PUBLIC_SITE_URL = 'http://localhost:8184'
WEBAPP_BASE_URL = 'http://localhost:8184'
# CACHE_INVALIDATE_KEY = 'replace_with_webhook_secret'
# CMS_PREVIEW_SECRET = 'replace_with_at_least_32_random_characters'
# BLOCK_PREVIEW_KEY = 'replace_with_preview_proxy_secret'

# -----------------------------------------------------------------------------
# Security, uploads and maintenance
# -----------------------------------------------------------------------------

# Generate with: php spark key:generate
encryption.key = ''

FILE_MAX_SIZE = 10485760
# GOOGLE_CLIENT_ID = 'client-id.apps.googleusercontent.com'

# Set MAINTENANCE_MODE=true only for an intentional maintenance window.
# MAINTENANCE_MODE = false
# MAINTENANCE_MESSAGE = 'Service is temporarily unavailable for maintenance.'
# MAINTENANCE_RETRY_AFTER = 60

# Optional Content-Security-Policy reporting endpoint.
# CSP_REPORT_URI = 'https://example.invalid/csp-report'

# -----------------------------------------------------------------------------
# Request throttling and dashboard delivery budgets
# -----------------------------------------------------------------------------

ADMIN_RATE_LIMIT_REQUESTS = 200
ADMIN_RATE_LIMIT_WINDOW = 60
ADMIN_DASHBOARD_FRESH_TTL = 300
ADMIN_DASHBOARD_STALE_TTL = 3600
ADMIN_DASHBOARD_FAILURE_COOLDOWN = 15
ADMIN_DASHBOARD_LOCK_MAX_AGE = 120
ADMIN_DASHBOARD_LOCK_WAIT_MS = 0
ADMIN_DASHBOARD_MAX_RETRIES = 0

# -----------------------------------------------------------------------------
# Uppercase compatibility aliases
# -----------------------------------------------------------------------------
# Use these only when the deployment cannot provide dotted keys. Do not set
# both forms to different values; dotted keys take precedence in the clients.
#
# Hub: API_BASE_URL, API_PREFIX, API_TIMEOUT, API_CONNECT_TIMEOUT,
#      API_APP_NAME, API_APP_KEY, API_LOG_REQUESTS, API_MAX_RETRIES
# CMS: DOMAIN_API_BASE_URL, DOMAIN_API_PREFIX, DOMAIN_API_TIMEOUT,
#      DOMAIN_API_CONNECT_TIMEOUT, DOMAIN_API_APP_NAME,
#      DOMAIN_API_APP_KEY, DOMAIN_API_LOG_REQUESTS
# Catalog: CATALOG_DOMAIN_API_BASE_URL, CATALOG_DOMAIN_API_APP_NAME,
#          CATALOG_DOMAIN_API_KEY
# Event: EVENT_DOMAIN_API_BASE_URL, EVENT_DOMAIN_API_APP_NAME,
#        EVENT_DOMAIN_API_KEY
# BFF: BFF_API_BASE_URL, BFF_API_PREFIX, BFF_API_TIMEOUT,
#      BFF_API_CONNECT_TIMEOUT, BFF_API_APP_NAME,
#      BFF_API_APP_KEY, BFF_API_LOG_REQUESTS
# Session/cache: SESSION_DRIVER, SESSION_SAVE_PATH, ADMIN_CACHE_HANDLER
# Other direct readers: APP_NAME, APP_DATE_FORMAT, ADMIN_PERMISSIONS,
#   PUBLIC_SITE_URL, WEBAPP_BASE_URL, CACHE_INVALIDATE_KEY, CMS_PREVIEW_SECRET,
#   BLOCK_PREVIEW_KEY, GOOGLE_CLIENT_ID, FILE_MAX_SIZE, CSP_REPORT_URI,
#   ASSET_VERSION, LOG_FORMAT, MAINTENANCE_MODE, MAINTENANCE_MESSAGE,
#   MAINTENANCE_RETRY_AFTER, ADMIN_RATE_LIMIT_REQUESTS,
#   ADMIN_RATE_LIMIT_WINDOW and ADMIN_DASHBOARD_*.
